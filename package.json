{
  "name": "dsh-multi-acp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Drive external ACP agent CLIs (omp / opencode / command-code / ...) as DSH root agents. Engines are data rows, not code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EJDRONE/dsh-multi-acp.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./preset-marker": "./lib/preset-marker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CONTEXT.md",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/index.impl.js && node --check lib/config.js && node --check lib/client.js && node --check lib/acp-agent.js",
    "test": "node --test \"test/**/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json",
    "diagnose:host": "node scripts/diagnose-host-resolution.mjs",
    "verify:profile": "node scripts/verify-profile-config.mjs"
  },
  "dsh": {
    "plugin": true,
    "kind": "server",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-commands": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-scope": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-web": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18 <4"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.25.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.20.0",
    "typescript": "5.7.2",
    "yaml": "^2.9.1"
  }
}
